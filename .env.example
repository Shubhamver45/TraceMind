# Incident Brain — environment configuration
# Copy this file to .env and fill in your values

# ── FalkorDB Cloud connection ───────────────────────────────────────────────
# Sign up free at https://app.falkordb.cloud
# After creating a database, copy the host, port, and password from the dashboard.
FALKORDB_HOST=your-instance.falkordb.cloud
FALKORDB_PORT=6379
FALKORDB_PASSWORD=your_password_here
FALKORDB_GRAPH_NAME=incident_brain

# ── Google Gemini API Key ───────────────────────────────────────────────────
# Get free at https://aistudio.google.com/apikey
# The agent works without this (fallback mode) but is smarter with it.
GOOGLE_API_KEY=your_api_key_here

# ── App Settings ────────────────────────────────────────────────────────────
FLASK_PORT=5001
DEBUG=true
